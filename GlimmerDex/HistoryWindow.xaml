<Window x:Class="GlimmerDex.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiny Hunting History" 
        Height="700" 
        Width="950"
        Background="#2D5A7B">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PC Box Header -->
        <Border Grid.Row="0" 
                Background="#1A3A4F"
                CornerRadius="8,8,0,0"
                Padding="15,10"
                BorderBrush="#0F2838"
                BorderThickness="3,3,3,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✨ " 
                               FontSize="24" 
                               Foreground="#FFD700"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="SHINY POKEMON BOX" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Recent Catches" 
                               FontSize="14" 
                               Foreground="#87CEEB"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border Background="#FFD700" 
                            CornerRadius="10" 
                            Padding="8,4">
                        <TextBlock x:Name="countLabel"
                                   Text="10" 
                                   FontSize="12" 
                                   FontWeight="Bold"
                                   Foreground="#1A3A4F"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PC Box Grid -->
        <Border Grid.Row="1"
                Background="#E8F0F5"
                CornerRadius="0,0,8,8"
                BorderBrush="#0F2838"
                BorderThickness="3,0,3,3"
                Padding="20">
            <Border Background="#FFFFFF"
                    CornerRadius="5"
                    BorderBrush="#B0C4DE"
                    BorderThickness="2"
                    Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="historyListView">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FBFF"
                                        BorderBrush="#B0C4DE"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Margin="5"
                                        Padding="8"
                                        Width="150"
                                        Height="180"
                                        ToolTipService.ShowDuration="60000">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <!-- Tooltip with details -->
                                    <Border.ToolTip>
                                        <ToolTip Background="#1A3A4F" 
                                                 BorderBrush="#FFD700" 
                                                 BorderThickness="2"
                                                 Padding="10">
                                            <StackPanel>
                                                <TextBlock FontSize="14" 
                                                          FontWeight="Bold" 
                                                          Foreground="#FFD700"
                                                          Margin="0,0,0,5">
                                                    <Run Text="✨ "/>
                                                    <Run Text="{Binding PokemonName, Mode=OneWay}"/>
                                                </TextBlock>
                                                
                                                <TextBlock FontSize="11" 
                                                          Foreground="White"
                                                          Margin="0,2">
                                                    <Run Text="Game: "/>
                                                    <Run Text="{Binding Game, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                
                                                <TextBlock FontSize="11" 
                                                          Foreground="White"
                                                          Margin="0,2">
                                                    <Run Text="Method: "/>
                                                    <Run Text="{Binding EncounterType, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                
                                                <TextBlock FontSize="11" 
                                                          Foreground="White"
                                                          Margin="0,2">
                                                    <Run Text="Encounters: "/>
                                                    <Run Text="{Binding TotalEncounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
                                                </TextBlock>
                                                
                                                <TextBlock FontSize="10" 
                                                          Foreground="#B0C4DE"
                                                          Margin="0,5,0,0"
                                                          Text="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy hh:mm tt}', Mode=OneWay}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Shiny Star Badge -->
                                        <Border Grid.Row="0"
                                                Background="#FFD700"
                                                CornerRadius="3"
                                                Padding="4,2"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,5">
                                            <TextBlock Text="★ SHINY ★" 
                                                      FontSize="9" 
                                                      FontWeight="Bold"
                                                      Foreground="#1A3A4F"/>
                                        </Border>

                                        <!-- Pokemon Sprite -->
                                        <Viewbox Grid.Row="1" 
                                                 Stretch="Uniform"
                                                 Margin="5">
                                            <Image Source="{Binding ShinyIconUrl, Mode=OneWay}" 
                                                   Width="96" 
                                                   Height="96"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Viewbox>

                                        <!-- Pokemon Name -->
                                        <Border Grid.Row="2"
                                                Background="#1A3A4F"
                                                CornerRadius="3"
                                                Padding="5,3"
                                                Margin="0,5,0,0">
                                            <TextBlock Text="{Binding PokemonName, Mode=OneWay}" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      TextAlignment="Center"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
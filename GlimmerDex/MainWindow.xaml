<Window x:Class="GlimmerDex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlimmerDex" Height="700" Width="1200"
        Background="#F0F4F8">
	<Window.Resources>
		<Style x:Key="SidebarButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#3B3B3B"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#505050"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="HuntButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#3498DB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#2980B9"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#21618C"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#BDC3C7"/>
					<Setter Property="Foreground" Value="#7F8C8D"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="ShinyButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#FFD700"/>
			<Setter Property="Foreground" Value="#1A252F"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="20,15"/>
			<Setter Property="FontWeight" Value="ExtraBold"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFC700"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#E5B800"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#BDC3C7"/>
					<Setter Property="Foreground" Value="#7F8C8D"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Border Grid.Column="0" Background="#2C3E50" CornerRadius="0,10,10,0" Margin="0,10,5,10">
			<StackPanel Margin="15">
				<Border Background="#1A252F" CornerRadius="8" Padding="10" Margin="0,0,0,30">
					<StackPanel>
						<TextBlock Text="✨" FontSize="32" HorizontalAlignment="Center" Margin="0,5"/>
						<TextBlock Text="GlimmerDex" FontSize="26" Foreground="#ECF0F1" FontWeight="Bold" TextAlignment="Center"/>
						<TextBlock Text="Shiny Hunter" FontSize="12" Foreground="#95A5A6" TextAlignment="Center" Margin="0,5,0,0"/>
					</StackPanel>
				</Border>

				<Button Content="🏠 Home" Click="HomeButton_Click" Style="{StaticResource SidebarButtonStyle}"/>
				<Button Content="✨ Collection" Click="ShinyPokemonButton_Click" Style="{StaticResource SidebarButtonStyle}"/>
				<Button Content="📜 History" Click="HistoryButton_Click" Style="{StaticResource SidebarButtonStyle}"/>

				<Border Background="#1A252F" CornerRadius="8" Padding="15" Margin="0,30,0,0">
					<StackPanel>
						<TextBlock Text="STATISTICS" FontSize="10" Foreground="#95A5A6" FontWeight="Bold" Margin="0,0,0,10"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<TextBlock Text="⭐" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
							<TextBlock x:Name="totalShiniesLabel" Text="0" FontSize="24" Foreground="#FFD700" FontWeight="Bold"/>
						</StackPanel>
						<TextBlock Text="Total Shinies" FontSize="11" Foreground="#BDC3C7" TextAlignment="Center" Margin="0,5,0,0"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</Border>

		<!-- Home Content -->
		<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="15">
			<Grid x:Name="homeGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="280"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Pokemon List Section -->
				<Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0" MaxHeight="650">
					<Border.Effect>
						<DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="SELECT POKÉMON" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,10"/>
						<TextBox x:Name="pokemonSearchBox"
                                 Height="35"
                                 TextChanged="PokemonSearchBox_TextChanged"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 FontSize="13"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"
                                 Margin="0,0,0,10">
							<TextBox.Resources>
								<Style TargetType="Border">
									<Setter Property="CornerRadius" Value="5"/>
								</Style>
							</TextBox.Resources>
						</TextBox>

						<ScrollViewer Height="520" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewer_ScrollChanged">
							<ItemsControl ItemsSource="{Binding DisplayedPokemonList}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="#F8F9FA" 
                                                BorderBrush="#E1E8ED" 
                                                BorderThickness="1"
                                                CornerRadius="5" 
                                                Margin="0,3" 
                                                Padding="8"
                                                MouseLeftButtonUp="PokemonItem_Click"
                                                Cursor="Hand">
											<Border.Style>
												<Style TargetType="Border">
													<Style.Triggers>
														<Trigger Property="IsMouseOver" Value="True">
															<Setter Property="Background" Value="#E3F2FD"/>
															<Setter Property="BorderBrush" Value="#2196F3"/>
														</Trigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<StackPanel Orientation="Horizontal">
												<Image Source="{Binding Icon}" Width="35" Height="35" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
												<TextBlock Text="{Binding Name}" 
                                                          VerticalAlignment="Center" 
                                                          FontSize="13"
                                                          FontWeight="Medium"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>

				<!-- Hunting Panel -->
				<Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
					<Border.Effect>
						<DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="CURRENT HUNT" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,15"/>

						<!-- Pokemon Display -->
						<Border Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,20">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<Border Grid.Column="0" Background="White" CornerRadius="8" Padding="5" Margin="0,0,15,0">
									<Image x:Name="selectedPokemonIcon"
                                           Width="80"
                                           Height="80"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
								</Border>

								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="Currently Hunting" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5"/>
									<Label x:Name="currentPokemonLabel"
                                           Content="Select a Pokémon"
                                           FontSize="20" 
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Padding="0,0,0,10"/>

									<StackPanel Orientation="Horizontal">
										<TextBlock Text="Game:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
										<ComboBox x:Name="gameSelector" Width="200" Height="30" FontSize="12">
											<ComboBoxItem Content="Pokémon Red"/>
											<ComboBoxItem Content="Pokémon Blue"/>
											<ComboBoxItem Content="Pokémon Yellow"/>
											<ComboBoxItem Content="Pokémon Gold"/>
											<ComboBoxItem Content="Pokémon Silver"/>
											<ComboBoxItem Content="Pokémon Crystal"/>
											<ComboBoxItem Content="Pokémon Ruby"/>
											<ComboBoxItem Content="Pokémon Sapphire"/>
											<ComboBoxItem Content="Pokémon Emerald"/>
											<ComboBoxItem Content="Pokémon FireRed"/>
											<ComboBoxItem Content="Pokémon LeafGreen"/>
											<ComboBoxItem Content="Pokémon Diamond"/>
											<ComboBoxItem Content="Pokémon Pearl"/>
											<ComboBoxItem Content="Pokémon Platinum"/>
											<ComboBoxItem Content="Pokémon HeartGold"/>
											<ComboBoxItem Content="Pokémon SoulSilver"/>
											<ComboBoxItem Content="Pokémon Black"/>
											<ComboBoxItem Content="Pokémon White"/>
											<ComboBoxItem Content="Pokémon Black 2"/>
											<ComboBoxItem Content="Pokémon White 2"/>
											<ComboBoxItem Content="Pokémon X"/>
											<ComboBoxItem Content="Pokémon Y"/>
											<ComboBoxItem Content="Pokémon Omega Ruby"/>
											<ComboBoxItem Content="Pokémon Alpha Sapphire"/>
											<ComboBoxItem Content="Pokémon Sun"/>
											<ComboBoxItem Content="Pokémon Moon"/>
											<ComboBoxItem Content="Pokémon Ultra Sun"/>
											<ComboBoxItem Content="Pokémon Ultra Moon"/>
											<ComboBoxItem Content="Pokémon Let's Go Pikachu"/>
											<ComboBoxItem Content="Pokémon Let's Go Eevee"/>
											<ComboBoxItem Content="Pokémon Sword"/>
											<ComboBoxItem Content="Pokémon Shield"/>
											<ComboBoxItem Content="Pokémon Brilliant Diamond"/>
											<ComboBoxItem Content="Pokémon Shining Pearl"/>
											<ComboBoxItem Content="Pokémon Legends: Arceus"/>
											<ComboBoxItem Content="Pokémon Scarlet"/>
											<ComboBoxItem Content="Pokémon Violet"/>
										</ComboBox>
									</StackPanel>
								</StackPanel>
							</Grid>
						</Border>

						<!-- Encounter Methods -->
						<TextBlock Text="ENCOUNTER METHODS" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,10"/>
						<UniformGrid Columns="2" HorizontalAlignment="Stretch">
							<!-- Wild Encounters -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,5,5">
								<StackPanel>
									<Label x:Name="encounterCountLabel" Content="Wild: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addEncounterButton" Content="+ Add Encounter" Click="AddEncounterButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- Eggs -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="5,0,0,5">
								<StackPanel>
									<Label x:Name="eggsCountLabel" Content="Eggs: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addEggButton" Content="+ Add Egg" Click="AddEggButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- Soft Resets -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,5,5">
								<StackPanel>
									<Label x:Name="softresetsCountLabel" Content="Resets: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addSoftResetsButton" Content="+ Add Reset" Click="AddSoftResetsButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- SOS -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="5,0,0,5">
								<StackPanel>
									<Label x:Name="sosCountLabel" Content="SOS: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addSOSButton" Content="+ Add SOS" Click="AddSOSButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- Catch Combo -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,5,5">
								<StackPanel>
									<Label x:Name="catchComboCountLabel" Content="Combo: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addCatchComboButton" Content="+ Add Combo" Click="AddCatchComboButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- Outbreak -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="5,0,0,5">
								<StackPanel>
									<Label x:Name="outbreakCountLabel" Content="Outbreak: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addOutbreakButton" Content="+ Add Outbreak" Click="AddOutbreakButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>

							<!-- DexNav -->
							<Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,5,5">
								<StackPanel>
									<Label x:Name="dexNavCountLabel" Content="DexNav: 0" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Padding="0,0,0,8"/>
									<Button x:Name="addDexNavButton" Content="+ Add DexNav" Click="AddDexNavButton_Click" IsEnabled="False" Style="{StaticResource HuntButtonStyle}" HorizontalAlignment="Stretch"/>
								</StackPanel>
							</Border>
						</UniformGrid>

						<!-- Shiny Button -->
						<Button x:Name="shinyButton"
                                Content="✨ FOUND SHINY! (0)"
                                Click="ShinyButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource ShinyButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,20,0,0"/>
					</StackPanel>
				</Border>
			</Grid>
		</ScrollViewer>

		<!-- Shiny Collection Grid (PC Box Style) -->
		<Grid x:Name="shinyGrid" Grid.Column="1" Visibility="Collapsed" Margin="15">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- PC Box Header -->
			<Border Grid.Row="0" 
                    Background="#1A3A4F"
                    CornerRadius="8,8,0,0"
                    Padding="15,10"
                    BorderBrush="#0F2838"
                    BorderThickness="3,3,3,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Horizontal">
						<TextBlock Text="✨ " 
                                   FontSize="24" 
                                   Foreground="#FFD700"
                                   VerticalAlignment="Center"/>
						<TextBlock Text="SHINY COLLECTION" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
					</StackPanel>

					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<TextBlock Text="Total Shinies" 
                                   FontSize="14" 
                                   Foreground="#87CEEB"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
						<Border Background="#FFD700" 
                                CornerRadius="10" 
                                Padding="8,4">
							<TextBlock x:Name="shinyCountLabel"
                                       Text="0" 
                                       FontSize="12" 
                                       FontWeight="Bold"
                                       Foreground="#1A3A4F"/>
						</Border>
					</StackPanel>
				</Grid>
			</Border>

			<!-- PC Box Grid -->
			<Border Grid.Row="1"
                    Background="#E8F0F5"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#0F2838"
                    BorderThickness="3,0,3,3"
                    Padding="20">
				<Border Background="#FFFFFF"
                        CornerRadius="5"
                        BorderBrush="#B0C4DE"
                        BorderThickness="2"
                        Padding="15">
					<ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
						<ItemsControl x:Name="shinyPokemonList">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#F8FBFF"
                                            BorderBrush="#B0C4DE"
                                            BorderThickness="2"
                                            CornerRadius="5"
                                            Margin="5"
                                            Padding="8"
                                            Width="150"
                                            Height="180"
                                            MouseLeftButtonUp="ShinyPokemon_Click"
                                            Cursor="Hand"
                                            ToolTipService.ShowDuration="60000">
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="#E3F2FD"/>
														<Setter Property="BorderBrush" Value="#2196F3"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>

										<!-- Tooltip with only non-zero methods -->
										<Border.ToolTip>
											<ToolTip Background="#1A3A4F" 
                                                     BorderBrush="#FFD700" 
                                                     BorderThickness="2"
                                                     Padding="10">
												<StackPanel>
													<TextBlock FontSize="14" 
                                                              FontWeight="Bold" 
                                                              Foreground="#FFD700"
                                                              Margin="0,0,0,8">
														<Run Text="✨ "/>
														<Run Text="{Binding PokemonData.Name, Mode=OneWay}"/>
													</TextBlock>

													<TextBlock FontSize="11" 
                                                              Foreground="White"
                                                              Margin="0,3">
														<Run Text="🎮 "/>
														<Run Text="{Binding ShinyRecord.Game, Mode=OneWay}" FontWeight="Bold"/>
													</TextBlock>

													<Border BorderBrush="#2C3E50" BorderThickness="0,1,0,0" Margin="0,5"/>

													<!-- Wild Encounters -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="🌿 Wild: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.Encounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.Encounters}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- Eggs -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="🥚 Eggs: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.EggsHatched, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.EggsHatched}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- Soft Resets -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="🔄 Resets: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.SoftResets, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.SoftResets}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- SOS -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="⛓️ SOS: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.SOSEncounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.SOSEncounters}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- Catch Combo -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="🎯 Combo: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.CatchComboEncounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.CatchComboEncounters}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- Outbreak -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="💥 Outbreak: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.OutbreakEncounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.OutbreakEncounters}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<!-- DexNav -->
													<TextBlock FontSize="11" Foreground="White" Margin="0,2">
														<Run Text="📡 DexNav: "/>
														<Run Text="{Binding ShinyRecord.EncounterData.DexNavEncounters, Mode=OneWay}" FontWeight="Bold" Foreground="#4ADE80"/>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ShinyRecord.EncounterData.DexNavEncounters}" Value="0">
																		<Setter Property="Visibility" Value="Collapsed"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<Border BorderBrush="#2C3E50" BorderThickness="0,1,0,0" Margin="0,5"/>

													<TextBlock FontSize="10" 
                                                              Foreground="#B0C4DE"
                                                              Margin="0,5,0,0">
														<Run Text="📅 "/>
														<Run Text="{Binding ShinyRecord.CaptureDate, StringFormat='{}{0:MM/dd/yyyy}', Mode=OneWay}"/>
													</TextBlock>
												</StackPanel>
											</ToolTip>
										</Border.ToolTip>

										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>

											<!-- Shiny Star Badge -->
											<Border Grid.Row="0"
                                                    Background="#FFD700"
                                                    CornerRadius="3"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,5">
												<TextBlock Text="★ SHINY ★" 
                                                          FontSize="9" 
                                                          FontWeight="Bold"
                                                          Foreground="#1A3A4F"/>
											</Border>

											<!-- Pokemon Sprite -->
											<Viewbox Grid.Row="1" 
                                                     Stretch="Uniform"
                                                     Margin="5">
												<Image Source="{Binding PokemonData.ShinyIcon, Mode=OneWay}" 
                                                       Width="96" 
                                                       Height="96"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
											</Viewbox>

											<!-- Pokemon Name -->
											<Border Grid.Row="2"
                                                    Background="#1A3A4F"
                                                    CornerRadius="3"
                                                    Padding="5,3"
                                                    Margin="0,5,0,0">
												<TextBlock Text="{Binding PokemonData.Name, Mode=OneWay}" 
                                                          FontSize="12" 
                                                          FontWeight="Bold"
                                                          Foreground="White"
                                                          TextAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"/>
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</Border>
		</Grid>
	</Grid>
</Window>